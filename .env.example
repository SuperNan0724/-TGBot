# ────────────────────────────────────────────────────────────
#  小南专属TGbot —— 环境变量模板（Docker / systemd / 云平台用）
#
#  用法： cp .env.example .env   然后填上你的值
#  ⚠️ .env 已被 .gitignore 忽略，**绝对不要**提交到仓库！
#
#  规则：
#   • 变量名与 src/config.example.py 里的配置项**同名**
#   • 留空 = 不覆盖（保留 config.example.py 里的默认值）
#   • 环境变量优先级最高，会覆盖 config.py / 模板里的值
#   • bool 项写 true/false/1/0/yes/no 都行，int 项直接写数字
# ────────────────────────────────────────────────────────────

# ── 必填 ──
# 从 @BotFather 拿：/newbot → 复制 Token
TELEGRAM_BOT_TOKEN=
# 你的数字 ID（@userinfobot 可查）。不填则主人专属命令不可用
BOT_OWNER_ID=

# ── 强烈建议 ──
# DeepSeek API Key（不填则 AI 聊天 / 性格 / 思考 / 女友模式不可用）
DEEPSEEK_API_KEY=
# 国内网络访问 Telegram 必填，例如 Clash 的 http://127.0.0.1:7897
# 注意：容器里 127.0.0.1 指的是容器自己，宿主机代理要写
#   http://host.docker.internal:7897   （Docker Desktop）
#   http://172.17.0.1:7897             （Linux 宿主机网桥）
PROXY_URL=

# ── 可选：外观 ──
BOT_NAME=
BOT_NAME_SHORT=
BOT_OWNER_NAME=

# ── 可选：AI / 媒体 ──
# 视觉模型必须支持图片，deepseek-chat 是纯文本模型会报错
VISION_MODEL=
# true = 关闭思考（默认，快且省 token）
DISABLE_THINKING=
# 链接解析总开关
LINK_PARSER_ENABLED=
# 是否用 AI 生成链接简介（关了省额度）
LINK_AI_SUMMARY=
# 视频下载体积上限（MB）
LINK_MAX_DOWNLOAD_MB=

# ── 可选：发卡平台回调服务器 ──
# 不接发卡平台就全部留空，回调服务不会启动
CALLBACK_HOST=
CALLBACK_PORT=
# 必须改成随机字符串，否则回调服务拒绝启动（防止伪造支付回调）
CALLBACK_SECRET=

# ── 可选：其他 ──
# ffmpeg 在 PATH 里就不用填
FFMPEG_PATH=
# 是否禁用自动语音（默认 true = 不发语音）
DISABLE_AUTO_VOICE=
